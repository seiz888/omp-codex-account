{
  "name": "pi-codex-account",
  "version": "0.1.1",
  "description": "Oh My Pi extension to switch between multiple OpenAI Codex OAuth accounts via OMP agent.db or legacy Pi auth.json.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "openai",
    "oauth",
    "oh-my-pi",
    "omp"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MateuszJuszczyk/pi-codex-account.git"
  },
  "bugs": {
    "url": "https://github.com/MateuszJuszczyk/pi-codex-account/issues"
  },
  "homepage": "https://github.com/MateuszJuszczyk/pi-codex-account#readme",
  "files": [
    "src",
    "assets",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "typecheck:omp": "tsc --noEmit -p tsconfig.omp.json",
    "typecheck:all": "bun run typecheck && bun run typecheck:omp"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@oh-my-pi/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/bun": "latest",
    "typescript": "^5.9.3",
    "@oh-my-pi/pi-coding-agent": "latest"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    }
  }
}
